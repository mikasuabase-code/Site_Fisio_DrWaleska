# ==============================================================================
# Dra. Waleska Paula — variáveis de ambiente
#
# Copie este arquivo para ".env" e preencha com os SEUS valores.
# O arquivo ".env" NUNCA deve ser enviado ao Git (já está no .gitignore).
#
#   cp .env.example .env
#
# As chaves abaixo são obtidas no painel do Supabase:
#   Project Settings > API
# ==============================================================================

# ------------------------------ Supabase ------------------------------
# URL do projeto (Project Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica "anon" — use apenas se um dia o frontend falar direto com o
# Supabase. Hoje o frontend NÃO acessa o banco, então esta chave pode ficar vazia.
# NUNCA coloque conteúdo clínico acessível por esta chave.
SUPABASE_ANON_KEY=

# Chave SECRETA "service_role" — dá acesso total ao banco.
# ATENÇÃO: fica SOMENTE no servidor (variável de ambiente). Jamais no frontend
# e jamais commitada no Git.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------- Banco de dados ---------------------------
# Connection string do Postgres (Project Settings > Database).
# NUNCA cole a URL real neste arquivo versionado. Use somente o .env local
# ou a variavel de ambiente do servidor.
DATABASE_URL=

# Com DATABASE_URL definida, o Flask usa PostgreSQL/Supabase.
# "sqlite" forca o fallback local (data/waleska.db), mesmo com DATABASE_URL.
# "supabase" ou "postgres" exigem DATABASE_URL.
DB_BACKEND=supabase

# ------------------------------ Painel --------------------------------
# Credenciais do administrador criadas no primeiro boot (quando o banco está vazio).
# Troque a senha pelo próprio painel depois do primeiro acesso.
ADMIN_EMAIL=admin@waleskapaula.com.br
ADMIN_PASSWORD=waleska2024

# ------------------------------ Servidor ------------------------------
PORT=8000
